# ============================================
# StockVision - Environment Variables
# ============================================
# Copia este archivo como .env y completa los valores

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tudominio.com

# --- PostgreSQL ---
POSTGRES_DB=stockvision
POSTGRES_USER=stockvision_user
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-segura
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Email (Mailtrap via Anymail) ---
MAILTRAP_API_TOKEN=tu-token-de-mailtrap
DEFAULT_FROM_EMAIL=Correo StockVision <Correo@stockvision.site>

# --- CORS ---
# Orígenes permitidos separados por coma (dejar vacío si se usa Nginx como proxy)
CORS_ALLOWED_ORIGINS=
